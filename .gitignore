# Credentials & Tokens
credentials.json
client_secret.json
token.json
token_backup.json
token*.json
*.json.token
.env
.env.*

# Python Cache
__pycache__/
*.pyc
.pytest_cache/

# Render Output & Temporary directories
output/
temp/
tmp/
uploaded_archive/
assets/gods_processed/

# Ignore large media formats
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.mp3

# Runtime artifacts
data/research/*
data/decision/*
data/content_briefs/*
data/scripts/*
data/audio/*
data/visuals/*
data/videos/*
data/thumbnails/*
data/pipeline/*
data/publishing/*
data/qa/*

# Keep gitkeep, persistent history file, canonical test asset plan fixture, and devotional audio assets
!data/publishing_history.json
!.gitkeep
!data/visuals/asset_plan_20260814_071510.json
!assets/music/devotional/*.mp3
!assets/music/pixabay/*.mp3
