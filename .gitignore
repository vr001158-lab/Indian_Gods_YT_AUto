# Credentials & Tokens
credentials.json
client_secret.json
token.json
*.json.token
.env
.env.*

# Python Cache
__pycache__/
*.pyc

# Render Output & Temporary directories
output/
temp/
tmp/
uploaded_archive/
assets/gods_processed/

# Ignore video formats to prevent raw outputs from being tracked
*.mp4
*.mov
*.avi
*.mkv

# Research Engine — generated runtime artifacts
data/research/*

# Decision Engine — generated runtime artifacts
data/decision/*

# Content Brief Engine — generated runtime artifacts
data/content_briefs/*

# Script Engine — generated runtime artifacts
data/scripts/*

# Voice Engine — generated runtime artifacts
data/audio/*

# Visual Engine — generated runtime artifacts
data/visuals/*

# Video Engine — generated runtime artifacts
data/videos/*

# Thumbnail Engine — generated runtime artifacts
data/thumbnails/*

# Pipeline Engine — generated runtime artifacts
data/pipeline/*
